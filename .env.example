# Environment Configuration for Story Vault App

# Server Configuration
NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:3000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/storyvault_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=storyvault_db
DB_USER=storyvault_user
DB_PASSWORD=your_secure_password

# Redis Configuration (for caching and job queue)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your_super_secure_jwt_secret_key_here_make_it_long_and_random

# OAuth API Keys - Social Media Platforms

# Twitter API v2 (Developer Account Required)
TWITTER_CONSUMER_KEY=your_twitter_consumer_key
TWITTER_CONSUMER_SECRET=your_twitter_consumer_secret
TWITTER_BEARER_TOKEN=your_twitter_bearer_token
TWITTER_CALLBACK_URL=http://localhost:3001/api/auth/twitter/callback

# Facebook/Instagram API (Facebook Developer Account)
FACEBOOK_CLIENT_ID=your_facebook_app_id
FACEBOOK_CLIENT_SECRET=your_facebook_app_secret
FACEBOOK_CALLBACK_URL=http://localhost:3001/api/auth/facebook/callback
INSTAGRAM_CALLBACK_URL=http://localhost:3001/api/auth/instagram/callback
FACEBOOK_VERIFY_TOKEN=your_facebook_webhook_verify_token

# Google API (YouTube, Google OAuth)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Spotify API (Spotify Developer Account)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_CALLBACK_URL=http://localhost:3001/api/auth/spotify/callback

# TikTok API (TikTok Developer Account)
TIKTOK_CLIENT_ID=your_tiktok_client_id
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret

# Payment Processing - Stripe
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Stripe Price IDs (create these in Stripe Dashboard)
STRIPE_MONTHLY_PRICE_ID=price_monthly_subscription_id
STRIPE_YEARLY_PRICE_ID=price_yearly_subscription_id

# Cloud Storage - AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=storyvault-user-media

# Email Service - SendGrid or AWS SES
SENDGRID_API_KEY=your_sendgrid_api_key
FROM_EMAIL=noreply@yourdomain.com
SUPPORT_EMAIL=support@yourdomain.com

# Or use AWS SES instead of SendGrid
AWS_SES_REGION=us-east-1
AWS_SES_ACCESS_KEY=your_ses_access_key
AWS_SES_SECRET_KEY=your_ses_secret_key

# Monitoring & Analytics
SENTRY_DSN=your_sentry_dsn_for_error_tracking
GOOGLE_ANALYTICS_ID=your_ga_tracking_id

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Limits
MAX_FILE_SIZE=10485760
MAX_FILES_PER_UPLOAD=5

# Background Jobs
JOB_CONCURRENCY=5
JOB_ATTEMPTS=3

# Push Notifications (Optional)
FIREBASE_SERVER_KEY=your_firebase_server_key
FIREBASE_PROJECT_ID=your_firebase_project_id

# Development Tools
LOG_LEVEL=info
ENABLE_CORS=true
ENABLE_HTTPS=false

# Production Security Headers
HELMET_CSP_ENABLED=true
HELMET_HSTS_ENABLED=true

# Session Configuration (if using sessions)
SESSION_SECRET=another_super_secure_random_string_for_sessions

# API Versioning
API_VERSION=v1

# Feature Flags
ENABLE_SOCIAL_SYNC=true
ENABLE_REAL_TIME_NOTIFICATIONS=true
ENABLE_BACKGROUND_JOBS=true
ENABLE_EMAIL_NOTIFICATIONS=true

# Admin Configuration
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=secure_admin_password

# Backup Configuration
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# CDN Configuration (Optional)
CDN_URL=https://cdn.yourdomain.com
STATIC_FILES_CDN=true